From fbee9c9c37182a2a8d9374caf750b2bb94b61732 Mon Sep 17 00:00:00 2001
From: Julien Jerphanion <git@jjerphan.xyz>
Date: Tue, 28 Jul 2026 09:37:00 +0200
Subject: [PATCH 1/1] subprocess: Use alternative for
 posix_spawn_file_actions_addchdir_np on older glibc

posix_spawn_file_actions_addchdir_np was added in glibc 2.29. conda-forge
still builds llama.cpp against glibc 2.17 and 2.28, so the unconditional
call fails at compile time.

On glibc < 2.29, return ENOSYS when a custom cwd is requested instead of
calling posix_spawn_file_actions_addchdir_np. Spawning without cwd is
unchanged.
---
 vendor/sheredom/subprocess.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/vendor/sheredom/subprocess.h b/vendor/sheredom/subprocess.h
index 5e80902..aeed4eb 100644
--- a/vendor/sheredom/subprocess.h
+++ b/vendor/sheredom/subprocess.h
@@ -1207,6 +1207,9 @@ cleanup:
   if (process_cwd) {
 #if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED >= 260000
     posix_error = posix_spawn_file_actions_addchdir(&actions, process_cwd);
+#elif defined(__GLIBC__) && (!defined(__GLIBC_PREREQ) || !__GLIBC_PREREQ(2, 29))
+    // posix_spawn_file_actions_addchdir_np requires glibc 2.29+
+    posix_error = ENOSYS;
 #else
 #if defined(__APPLE__) && defined(__clang__)
 #pragma clang diagnostic push
-- 
2.55.0

